{
  "algorithm": "dms",
  "env": "mamujoco",
  "mamujoco_backend": "legacy",
  "scenario": "HalfCheetah",
  "ant_contact_forces": "native",
  "agent_conf": "2x3",
  "agent_obsk": 1,
  "map_name": "3s5z",
  "seed": 101,
  "device": "cuda",
  "num_envs": 4,
  "parallel_env_steps": false,
  "mask_inactive_agents": false,
  "smac_time_limit_terminal": false,
  "update_mode": "independent",
  "total_steps": 3000000,
  "rollout_steps": 1000,
  "epochs": 5,
  "minibatch_size": 1000,
  "hidden_dim": 64,
  "policy_history_length": 32,
  "initial_log_std": -0.5,
  "latent_dim": 8,
  "decoder_history": false,
  "history_length": 32,
  "prediction_horizon": 4,
  "coordination": "soft",
  "coordination_threshold": 0.6,
  "short_history": 4,
  "filter_history": true,
  "intention_threshold": 10000,
  "warmup_episodes": 100,
  "causal_warmup_episodes": 100,
  "actor_lr": 0.0003,
  "critic_lr": 0.001,
  "intention_lr": 0.001,
  "intention_rl_lr": 0.0003,
  "aux_updates": 2,
  "aux_batch_size": 64,
  "kl_beta": 0.1,
  "latent_samples": 2,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "clip": 0.2,
  "value_clip": 0.2,
  "entropy_coef": 0.0,
  "value_coef": 0.5,
  "max_grad_norm": 0.5,
  "target_kl": 0.02,
  "eval_every": 1000000,
  "eval_episodes": 10,
  "eval_seed": 10001,
  "output": "runs/dev-legacy-halfcheetah-2x3-dms-history32-3m-cuda-joint-rl-101",
  "torch_threads": 1
}
